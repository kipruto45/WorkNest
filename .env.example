# Backend runtime reads `backend/.env`. Keep this file aligned only if you use it
# as the source for generating `backend/.env` or shell exports.
DEBUG=true
ENVIRONMENT=local
SECRET_KEY=YOUR_SECRET_KEY
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
PUBLIC_WEBAPP_URL=
APP_NAME=WorkNest
SUPPORT_EMAIL=support@worknest.example

POSTGRES_DB=worknest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_DATABASE_PASSWORD
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=YOUR_DATABASE_URL
DATABASE_SSL_REQUIRE=false
DB_SSL_MODE=

REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

DEFAULT_FROM_EMAIL=no-reply@example.com
EMAIL_FROM_NAME=WorkNest
EMAIL_PROVIDER=smtp
EMAIL_DELIVERY_MODE=async
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=YOUR_EMAIL_USERNAME
EMAIL_HOST_PASSWORD=YOUR_EMAIL_PASSWORD
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY

GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback/

SMS_ENABLED=false
SMS_PROVIDER=africas_talking
SMS_MAX_RETRIES=3
SMS_RETRY_BACKOFF_SECONDS=2
SMS_BROADCAST_CONFIRMATION_REQUIRED=true
SMS_REQUIRE_VERIFIED_PHONE=false
DEFAULT_COUNTRY_CODE=+254
# Testing / sandbox mode:
# - AFRICAS_TALKING_USERNAME must stay `sandbox`
# - AFRICAS_TALKING_API_KEY must be your sandbox API key
# - AFRICAS_TALKING_ENVIRONMENT must stay `sandbox`
AFRICAS_TALKING_USE_SANDBOX=true
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=YOUR_SANDBOX_API_KEY
AFRICAS_TALKING_SENDER_ID=
AFRICAS_TALKING_ENVIRONMENT=sandbox
AFRICAS_TALKING_BASE_URL=

ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth/
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax

NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_EMAIL_TYPES=task_assigned,mentioned_in_comment,deadline_approaching,comment_posted
NOTIFICATION_SMS_ENABLED=true
NOTIFICATION_SMS_TYPES=task_assigned,mentioned_in_comment,deadline_approaching,team_invite,admin_broadcast
NOTIFICATION_DEADLINE_REMINDER_WINDOWS_HOURS=24,1
NOTIFICATION_DEADLINE_REMINDER_GRACE_MINUTES=30

STATIC_URL=/static/
MEDIA_URL=/media/
FILES_URL=/files/

SUPABASE_URL=
SUPABASE_KEY=YOUR_SUPABASE_KEY
ATTACHMENTS_STORAGE_BACKEND=supabase
ATTACHMENTS_MAX_FILE_SIZE=10485760
ATTACHMENTS_SUPABASE_BUCKET=task-attachments
ATTACHMENTS_SIGNED_URL_TTL=300

SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_TIMEOUT=30
