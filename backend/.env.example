DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me
DEBUG=True
ENVIRONMENT=local
ALLOWED_HOSTS=127.0.0.1,localhost
PORT=8000
APP_SERVER=daphne
WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=120
RUN_MIGRATIONS=1
RUN_COLLECTSTATIC=1

POSTGRES_DB=worknest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# In `config.settings.local`, localhost/no DATABASE_URL now falls back to
# SQLite automatically for manual development. Docker Compose overrides
# POSTGRES_HOST to `postgres`, so it still uses Postgres there.
# Optional aliases when your host uses DB_* naming instead of POSTGRES_*
DB_NAME=worknest
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=
# On hosted platforms like Render, prefer the Supabase pooler connection string
# instead of the direct db.<project>.supabase.co host if the direct host is unreachable.
# Example shape:
# DATABASE_URL=postgresql://postgres:<password>@<pooler-host>:6543/postgres
DATABASE_CONN_MAX_AGE=60
DATABASE_SSL_REQUIRE=False
DB_SSL_MODE=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

DEFAULT_FROM_EMAIL=no-reply@example.com
EMAIL_FROM_NAME=WorkNest
EMAIL_PROVIDER=smtp
EMAIL_DELIVERY_MODE=sync
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
SMTP_HOST=
SMTP_PORT=0
SMTP_USERNAME=
SMTP_PASSWORD=
SENDGRID_API_KEY=

# Either GOOGLE_OAUTH_* or GOOGLE_CLIENT_* can be used
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback/

# Frontend Environment Variables (in frontend/.env)
# VITE_API_URL=http://localhost:8000/api/v1
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

SUPABASE_URL=
# Either SUPABASE_KEY or SUPABASE_SERVICE_ROLE_KEY can be used for server-side storage access
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_TIMEOUT=30
ATTACHMENTS_STORAGE_BACKEND=local
# Set to `supabase` in production after configuring the Supabase variables above.
ATTACHMENTS_MAX_FILE_SIZE=10485760
ATTACHMENTS_SUPABASE_BUCKET=task-attachments
ATTACHMENTS_SIGNED_URL_TTL=300
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
INVITE_LINK_BASE_URL=http://localhost:5173/invitations
PASSWORD_RESET_LINK_BASE_URL=http://localhost:5173/reset-password
APP_NAME=WorkNest
SUPPORT_EMAIL=support@worknest.local
LOGO_URL=http://localhost:5173/logo_hd.png
NOTIFICATION_EMAIL_ENABLED=True
NOTIFICATION_EMAIL_TYPES=task_assigned,mentioned_in_comment,deadline_approaching,comment_posted
NOTIFICATION_DEADLINE_REMINDER_HOURS=24
NOTIFICATION_DEADLINE_REMINDER_WINDOWS_HOURS=24,1
NOTIFICATION_DEADLINE_REMINDER_GRACE_MINUTES=30
EMAIL_TASK_MAX_RETRIES=3
EMAIL_RETRY_BACKOFF_SECONDS=2
WELCOME_EMAIL_ENABLED=True
TEAM_INVITATION_EXPIRY_DAYS=7
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth/
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax

MEDIA_URL=/media/
STATIC_URL=/static/
FILES_URL=/files/
