DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=YOUR_SECRET_KEY
DEBUG=True
ENVIRONMENT=local
ALLOWED_HOSTS=127.0.0.1,localhost
PORT=8000
APP_SERVER=daphne
WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=120
RUN_MIGRATIONS=1
RUN_COLLECTSTATIC=1

POSTGRES_DB=worknest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_DATABASE_PASSWORD
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# In `config.settings.local`, localhost/no DATABASE_URL now falls back to
# SQLite automatically for manual development. Docker Compose overrides
# POSTGRES_HOST to `postgres`, so it still uses Postgres there.
# Optional aliases when your host uses DB_* naming instead of POSTGRES_*
DB_NAME=worknest
DB_USER=postgres
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=YOUR_DATABASE_URL
# On hosted platforms like Render, prefer the Supabase pooler connection string
# instead of the direct db.<project>.supabase.co host if the direct host is unreachable.
# Example shape:
# DATABASE_URL=postgresql://postgres:<password>@<pooler-host>:6543/postgres
DATABASE_CONN_MAX_AGE=60
DATABASE_SSL_REQUIRE=False
DB_SSL_MODE=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

DEFAULT_FROM_EMAIL=no-reply@example.com
EMAIL_FROM_NAME=WorkNest
EMAIL_PROVIDER=smtp
EMAIL_DELIVERY_MODE=sync
# Leave EMAIL_BACKEND blank to let WorkNest choose the SMTP backend automatically.
EMAIL_BACKEND=
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=YOUR_EMAIL_USERNAME
EMAIL_HOST_PASSWORD=YOUR_EMAIL_PASSWORD
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
SMTP_HOST=
SMTP_PORT=0
SMTP_USERNAME=YOUR_SMTP_USERNAME
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY

# Either GOOGLE_OAUTH_* or GOOGLE_CLIENT_* can be used
GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback/
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/v1/calendar/google/callback/

# Frontend Environment Variables (in frontend/.env)
# VITE_API_URL=http://localhost:8000/api/v1
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

SUPABASE_URL=
# Either SUPABASE_KEY or SUPABASE_SERVICE_ROLE_KEY can be used for server-side storage access
SUPABASE_KEY=YOUR_SUPABASE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=
SUPABASE_TIMEOUT=30
STORAGE_PROVIDER=local
ATTACHMENTS_STORAGE_BACKEND=local
# Set to `supabase` for the legacy Supabase REST API, or `supabase_s3`
# to use the S3-compatible storage credentials below.
ATTACHMENTS_MAX_FILE_SIZE=10485760
ATTACHMENTS_SUPABASE_BUCKET=task-attachments
ATTACHMENTS_SIGNED_URL_TTL=300
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=eu-west-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET=task-attachments
SUPABASE_S3_FORCE_PATH_STYLE=true
SUPABASE_S3_SIGNED_URL_TTL=300
FRONTEND_URL=http://localhost:5173
PUBLIC_WEBAPP_URL=
BACKEND_URL=http://localhost:8000
INVITE_LINK_BASE_URL=http://localhost:5173/invitations
PASSWORD_RESET_LINK_BASE_URL=http://localhost:5173/reset-password
# Production example with your Vercel frontend:
# FRONTEND_URL=https://work-nest-lemon.vercel.app
# PUBLIC_WEBAPP_URL=https://work-nest-lemon.vercel.app
# INVITE_LINK_BASE_URL=https://work-nest-lemon.vercel.app/invitations
# PASSWORD_RESET_LINK_BASE_URL=https://work-nest-lemon.vercel.app/reset-password
# CORS_ALLOWED_ORIGINS=https://work-nest-lemon.vercel.app
# CSRF_TRUSTED_ORIGINS=https://work-nest-lemon.vercel.app
APP_NAME=WorkNest
SUPPORT_EMAIL=supportworknest@gmail.com
LOGO_URL=http://localhost:5173/logo_hd.png
NOTIFICATION_EMAIL_ENABLED=True
NOTIFICATION_EMAIL_TYPES=task_assigned,mentioned_in_comment,deadline_approaching,comment_posted
NOTIFICATION_DEADLINE_REMINDER_HOURS=24
NOTIFICATION_DEADLINE_REMINDER_WINDOWS_HOURS=24,1
NOTIFICATION_DEADLINE_REMINDER_GRACE_MINUTES=30
EMAIL_TASK_MAX_RETRIES=3
EMAIL_RETRY_BACKOFF_SECONDS=2
WELCOME_EMAIL_ENABLED=True
SMS_ENABLED=False
SMS_PROVIDER=africas_talking
SMS_MAX_RETRIES=3
SMS_RETRY_BACKOFF_SECONDS=2
SMS_BROADCAST_CONFIRMATION_REQUIRED=True
SMS_REQUIRE_VERIFIED_PHONE=False
DEFAULT_COUNTRY_CODE=+254
# Testing / sandbox mode:
# - AFRICAS_TALKING_USERNAME must stay `sandbox`
# - AFRICAS_TALKING_API_KEY must be your sandbox API key
# - AFRICAS_TALKING_ENVIRONMENT must stay `sandbox`
AFRICAS_TALKING_USE_SANDBOX=True
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=YOUR_SANDBOX_API_KEY
AFRICAS_TALKING_SENDER_ID=
AFRICAS_TALKING_ENVIRONMENT=sandbox
AFRICAS_TALKING_BASE_URL=
NOTIFICATION_SMS_ENABLED=True
NOTIFICATION_SMS_TYPES=task_assigned,mentioned_in_comment,deadline_approaching,team_invite,admin_broadcast
ADMIN_BOOTSTRAP_ENABLED=0
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=WorkNest Admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
TEAM_INVITATION_EXPIRY_DAYS=7
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth/
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax

MEDIA_URL=/media/
STATIC_URL=/static/
FILES_URL=/files/
