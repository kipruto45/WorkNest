APP_NAME=WorkNest PHP Backend
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=worknest_php
DB_USERNAME=root
DB_PASSWORD=

AUTH_TOKEN_EXPIRY=86400
SESSION_LIFETIME=120
SESSION_NAME=worknest_session
CSRF_ENABLED=true

MAIL_DRIVER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@worknest.local
MAIL_FROM_NAME=WorkNest PHP

UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx,xlsx,csv,zip
STORAGE_DRIVER=local

LOG_PATH=storage/logs
LOG_LEVEL=debug
APP_TIMEZONE=UTC