# Application
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_NAME=WorkNest
APP_VERSION=1.0.0

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=worknest
DB_USERNAME=root
DB_PASSWORD=

# Security
APP_KEY=your-32-character-secret-key-here
JWT_SECRET=your-jwt-secret-key-here
CSRF_TOKEN_SECRET=your-csrf-secret-key-here

# Session
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Mail
MAIL_DRIVER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=noreply@worknest.local
MAIL_FROM_NAME="${APP_NAME}"

# File Storage
UPLOAD_PATH=storage/uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx,zip,txt

# API
API_RATE_LIMIT=60
API_TOKEN_LIFETIME=86400

# Logging
LOG_PATH=storage/logs
LOG_LEVEL=debug

# Timezone
APP_TIMEZONE=UTC