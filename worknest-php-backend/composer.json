{
    "name": "worknest/php-backend",
    "description": "WorkNest - Team Collaboration & Task Management Backend",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "phpmailer/phpmailer": "^6.8",
        "dompdf/dompdf": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Core\\": "core/",
            "Database\\": "database/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}